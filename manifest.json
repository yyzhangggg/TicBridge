{
  "manifest_version": 3,
  "name": "TicBridge",
  "version": "0.1.0",
  "description": "发布排期 + Google Drive 取最新素材 + TikTok/小红书/Bilibili 发布页自动填充",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity", "activeTab"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://www.tiktok.com/tiktokstudio/upload*",
    "https://www.tiktok.com/upload*",
    "https://member.bilibili.com/platform/upload*",
    "https://creator.xiaohongshu.com/publish/publish*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/upload*", "https://www.tiktok.com/upload*"],
      "js": ["dist/content-scripts/tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://member.bilibili.com/platform/upload*"],
      "js": ["dist/content-scripts/bilibili.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/publish/publish*"],
      "js": ["dist/content-scripts/rednote.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "53673136120-9e6vd8aavs2b658ecabubvlec0q6v3hf.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/drive.readonly"
    ]
  }
}
